<UserControl x:Class="desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="860" Margin="48,40,48,40">

                <!-- Header -->
                <TextBlock Text="GUI Failure Lab" FontSize="30" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,4"/>
                <TextBlock Text="Desktop  ·  .NET 9 / WPF" FontSize="14" Foreground="#6B7280" Margin="0,0,0,36"/>

                <TextBlock Text="Failure Scenarios" FontSize="16" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>

                <!-- Failure card: B_NON_CLICKABLE_NORMAL_CTA -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="B_NON_CLICKABLE_NORMAL_CTA" FontSize="11" FontFamily="Consolas"
                                       Foreground="#9CA3AF" Margin="0,0,0,4"/>
                            <TextBlock Text="Non-clickable but visually normal CTA" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,6"/>
                            <TextBlock Text="A primary action button appears fully enabled but does not respond to pointer input."
                                       TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#EEF2FF" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                    <TextBlock Text="cross-platform" FontSize="11" Foreground="#4F46E5"/>
                                </Border>
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                    <TextBlock Text="easy" FontSize="11" Foreground="#16A34A"/>
                                </Border>
                                <Border Background="#FFF7ED" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="action_affordance" FontSize="11" Foreground="#D97706"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0">
                            <Button Content="Baseline" Command="{Binding OpenBaselineCommand}"
                                    Width="110" Height="36" Margin="0,0,0,8" FontSize="13"/>
                            <Button Content="Faulty" Command="{Binding OpenFaultyCommand}"
                                    Width="110" Height="36" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
