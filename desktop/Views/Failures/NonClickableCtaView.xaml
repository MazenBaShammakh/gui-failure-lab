<UserControl x:Class="desktop.Views.Failures.NonClickableCtaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:desktop.Converters">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" Margin="48,36,48,48">

                <!-- Breadcrumb -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <TextBlock FontSize="13">
                        <Hyperlink Command="{Binding GoBackCommand}" Foreground="#6B7280" TextDecorations="None">Home</Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" / failures / B_NON_CLICKABLE_NORMAL_CTA / " FontSize="13" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Variant}" FontSize="13" FontWeight="SemiBold" Foreground="#111827"/>
                </StackPanel>

                <!-- Fault status banner -->
                <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FaultActive}" Value="True">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="BorderBrush" Value="#FECACA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FaultActive}" Value="False">
                                    <Setter Property="Background" Value="#F0FDF4"/>
                                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FaultActive}" Value="True">
                                            <Setter Property="Text" Value="Faulty — fault active"/>
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FaultActive}" Value="False">
                                            <Setter Property="Text" Value="Baseline — no fault"/>
                                            <Setter Property="Foreground" Value="#15803D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="13" Foreground="#6B7280" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FaultActive}" Value="True">
                                            <Setter Property="Text" Value="· Place Order button is non-responsive"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FaultActive}" Value="False">
                                            <Setter Property="Text" Value="· Place Order button works normally"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Order card -->
                <!-- defect: B_NON_CLICKABLE_NORMAL_CTA | affected_step: 1 -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Complete Your Order" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="0,0,0,20"/>

                        <!-- Order line item -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Wireless Headphones Pro" FontSize="14"
                                           FontWeight="Medium" Foreground="#111827"/>
                                <TextBlock Text="Color: Midnight Black  ·  Qty: 1" FontSize="13"
                                           Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="$149.99" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#E5E7EB" Margin="0,0,0,16"/>

                        <!-- Total -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total" FontSize="15" FontWeight="SemiBold" Foreground="#111827"/>
                            <TextBlock Grid.Column="1" Text="$149.99" FontSize="15"
                                       FontWeight="Bold" Foreground="#111827"/>
                        </Grid>

                        <!--
                            FAULT: IsHitTestVisible=False in faulty mode.
                            The button is visually identical in both variants but ignores all pointer
                            input in the faulty variant — no visual affordance of the failure.
                        -->
                        <Button Content="Place Order"
                                Command="{Binding SubmitCommand}"
                                IsHitTestVisible="{Binding FaultActive, Converter={StaticResource InverseBool}}"
                                Height="44" FontSize="15" FontWeight="SemiBold"
                                Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   HorizontalAlignment="Center"
                                   Foreground="#16A34A"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Back -->
                <Button Content="← Back to index"
                        Command="{Binding GoBackCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,20,0,0"
                        FontSize="13"
                        Padding="8,4"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
