<UserControl x:Class="desktop.Views.Apps.Files.MoveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="{Binding DefectMarker}">

    <Grid Background="{StaticResource Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="520" Margin="40,32,40,48">

                <Button Content="← Files" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Left" Margin="-8,0,0,16"
                        Command="{Binding GoBackCommand}"/>

                <Border Style="{StaticResource Card}" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Move file" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,22">
                            <Run Text="{Binding FileName, Mode=OneWay}"/><Run Text=" · currently in Documents"/>
                        </TextBlock>

                        <TextBlock Text="Destination folder" FontSize="12"
                                   Foreground="{StaticResource InkMuted}" Margin="0,0,0,4"/>

                        <!--
                            Identical in both variants: editable, with type-ahead off so
                            typing never selects an item as a side effect. What differs is
                            only what the Move handler reads back (see MoveViewModel).
                        -->
                        <ComboBox x:Name="DestinationBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  AutomationProperties.Name="Destination folder"
                                  ItemsSource="{Binding Folders}"
                                  SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                  Text="{Binding DestinationText, UpdateSourceTrigger=PropertyChanged}"
                                  Height="32" FontSize="13" Padding="8,4" Margin="0,0,0,22"/>

                        <Button Content="Move"
                                AutomationProperties.Name="Move"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding MoveCommand}"
                                Height="42" FontSize="14" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Positive}" FontSize="13"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
