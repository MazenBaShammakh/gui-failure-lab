<UserControl x:Class="desktop.Views.Apps.Files.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="{Binding DefectMarker}">
    <Grid Background="{StaticResource Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" Margin="40,32,40,48">

                <Button Content="← Files" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Left" Margin="-8,0,0,16"
                        Command="{Binding GoBackCommand}"/>

                <TextBlock Text="Sync" Style="{StaticResource Title}" Margin="0,0,0,24"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Cloud folder" Style="{StaticResource SectionHeading}" Margin="0,0,0,4"/>
                        <TextBlock Text="Documents · 1,284 files · 3.2 GB" Style="{StaticResource Body}"
                                   Foreground="{StaticResource InkMuted}" Margin="0,0,0,20"/>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Body}" Margin="0,0,0,18"/>

                        <Button Content="Sync now"
                                AutomationProperties.Name="Sync now"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Padding="24,0"
                                Command="{Binding SyncNowCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
