<UserControl x:Class="desktop.Views.Apps.Files.FileLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:desktop.Controls"
             AutomationProperties.AutomationId="{Binding DefectMarker}">
    <Grid Background="{StaticResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="← Files" Style="{StaticResource SubtleButton}"
                            Command="{Binding GoBackCommand}"/>
                    <TextBlock Text="Documents" FontSize="13" FontWeight="SemiBold" Margin="14,0,0,0"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="Open"
                        AutomationProperties.Name="Open"
                        Style="{StaticResource PrimaryButton}" Height="30" Padding="18,0"
                        Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedFile}"/>
            </Grid>
        </Border>

        <!-- Column headers -->
        <Border Grid.Row="1" Background="{StaticResource Canvas}" Padding="20,8"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}"/>
                <TextBlock Grid.Column="1" Text="Type" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}"/>
                <TextBlock Grid.Column="2" Text="Size" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}"/>
                <TextBlock Grid.Column="3" Text="Modified" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}"/>
            </Grid>
        </Border>

        <!--
            Virtualization is explicitly set to Recycling: containers are reused and
            rebound as the list scrolls, which is the precondition the faulty
            AutomationPeer's cached name depends on (see Controls/FileRowItem.cs).
        -->
        <controls:FileRowListBox Grid.Row="2"
                                 ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding SelectedFile}"
                                 AutomationProperties.Name="Documents"
                                 BorderThickness="0" Background="{StaticResource Surface}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
            <controls:FileRowListBox.ItemContainerStyle>
                <Style TargetType="controls:FileRowItem">
                    <Setter Property="Padding" Value="20,7"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </controls:FileRowListBox.ItemContainerStyle>
            <controls:FileRowListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Ink}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="13" Foreground="{StaticResource InkMuted}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="13" Foreground="{StaticResource InkMuted}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Modified}" FontSize="13" Foreground="{StaticResource InkMuted}"/>
                    </Grid>
                </DataTemplate>
            </controls:FileRowListBox.ItemTemplate>
        </controls:FileRowListBox>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,8">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource Positive}"/>
        </Border>
    </Grid>
</UserControl>
