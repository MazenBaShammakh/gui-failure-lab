<UserControl x:Class="desktop.Views.Apps.Notes.PreferencesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The one card, used by both conditions: as an in-window overlay in baseline
        and as the content of a separate top-level window when the fault is armed.
        Sharing it is what keeps the two variants pixel-identical.
    -->
    <Border Style="{StaticResource Card}" Width="400" Padding="26"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Preferences" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" Margin="0,0,0,4"/>
            <TextBlock Text="Notes" Style="{StaticResource Subtitle}" Margin="0,0,0,20"/>

            <CheckBox Content="Autosave"
                      AutomationProperties.Name="Autosave"
                      IsChecked="{Binding AutosaveEnabled, Mode=TwoWay}"
                      FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Subtitle}" Margin="22,0,0,22"
                       Text="Save changes to every note as you type."/>

            <Button Content="Done"
                    AutomationProperties.Name="Done"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ClosePreferencesCommand}"
                    Height="38" HorizontalAlignment="Right" Width="96"/>
        </StackPanel>
    </Border>
</UserControl>
