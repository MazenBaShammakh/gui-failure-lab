<UserControl x:Class="desktop.Views.Apps.Notes.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:desktop.Views.Apps.Notes"
             AutomationProperties.AutomationId="{Binding DefectMarker}">

    <Grid Background="{StaticResource Canvas}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" Margin="40,32,40,48">

                <Button Content="← Notes" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Left" Margin="-8,0,0,16"
                        Command="{Binding GoBackCommand}"/>

                <TextBlock Text="Settings" Style="{StaticResource Title}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,20"
                           Text="Editor behaviour, sync and backup for the Notes app."/>

                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Editor" Style="{StaticResource SectionHeading}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource InkMuted}"
                                   Margin="0,0,0,18"
                                   Text="Autosave, spell check and formatting defaults are configured in Preferences."/>

                        <Button Content="Open preferences…"
                                AutomationProperties.Name="Open preferences"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenPreferencesCommand}"
                                Height="40" HorizontalAlignment="Left" Width="190"/>

                        <TextBlock Text="{Binding StatusMessage}" Margin="0,18,0,0"
                                   FontSize="13" Foreground="{StaticResource Positive}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--
            Baseline path: the card is an overlay in this window's own tree, so a
            harness reading the application window finds the Autosave checkbox
            exactly where it is looking. The faulty path shows the identical card in
            a separate top-level window instead (see PreferencesView.xaml.cs).
        -->
        <Grid Background="#66000000"
              Visibility="{Binding ShowInlinePanel, Converter={StaticResource BoolToVis}}">
            <local:PreferencesCard/>
        </Grid>

    </Grid>
</UserControl>
