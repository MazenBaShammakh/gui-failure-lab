<Window x:Class="desktop.Views.Apps.Store.RefundVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify your identity"
        AutomationProperties.Name="Verify your identity"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="Verify your identity" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource InkMuted}"
                       Margin="0,0,0,18"
                       Text="Refunds must be confirmed before they can be requested. Enter the last four digits of the card used for this order."/>

            <TextBox AutomationProperties.Name="Last four digits"
                     Text="{Binding EnteredDigits, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="4" Padding="9,7" FontSize="13"
                     BorderBrush="{StaticResource Line}" Margin="0,0,0,6"/>

            <TextBlock Text="{Binding VerifyMessage}" FontSize="12" Foreground="#C02B2B"
                       Margin="0,0,0,16" TextWrapping="Wrap"/>

            <!--
                An ordinary close affordance is kept deliberately (Cancel, plus the
                title-bar X), so this screen tests A7 alone and does not also
                instantiate F-INS-01, "blocking modal with tiny or no close
                affordance". Cancelling abandons the refund rather than skipping the
                check — see RefundViewModel.ShowRefundAction.
            -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        AutomationProperties.Name="Cancel"
                        Height="38" Width="100" Margin="0,0,8,0"
                        Click="OnCancelClick"/>
                <Button x:Name="VerifyButton" Content="Verify"
                        AutomationProperties.Name="Verify"
                        Style="{StaticResource PrimaryButton}"
                        Height="38" Width="110"
                        Click="OnVerifyClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
