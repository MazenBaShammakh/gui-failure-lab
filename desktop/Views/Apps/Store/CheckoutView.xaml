<UserControl x:Class="desktop.Views.Apps.Store.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:desktop.Converters"
             AutomationProperties.AutomationId="{Binding DefectMarker}">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="540" Margin="40,32,40,48">

                <Button Content="← Store" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Left" Margin="-8,0,0,16"
                        Command="{Binding GoBackCommand}"/>

                <Border Style="{StaticResource Card}" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Complete your order" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Wireless Headphones Pro" FontSize="14"
                                           FontWeight="Medium" Foreground="{StaticResource Ink}"/>
                                <TextBlock Text="Color: Midnight Black  ·  Qty: 1" FontSize="12"
                                           Foreground="{StaticResource InkMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="$149.99" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Grid.Column="1" Text="$149.99" FontSize="15"
                                       FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        </Grid>

                        <!--
                            FAULT: IsHitTestVisible=False when the fault is armed. The button
                            is visually identical in both variants but ignores all pointer
                            input — no visual affordance of the failure.
                        -->
                        <Button Content="Place order"
                                AutomationProperties.Name="Place order"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SubmitCommand}"
                                IsHitTestVisible="{Binding FaultActive, Converter={StaticResource InverseBool}}"
                                Height="44" FontSize="15" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Positive}" FontSize="13"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
