<UserControl x:Class="desktop.Views.Apps.Store.ShippingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="{Binding DefectMarker}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="520" Margin="40,32,40,48">

                <Button Content="← Store" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Left" Margin="-8,0,0,16"
                        Command="{Binding GoBackCommand}"/>

                <Border Style="{StaticResource Card}" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Delivery address" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,0,0,20"/>

                        <TextBlock Text="Recipient" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Field}" Margin="0,0,0,14"
                                 AutomationProperties.Name="Recipient"
                                 Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Street and number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Field}" Margin="0,0,0,14"
                                 AutomationProperties.Name="Street and number"
                                 Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="City" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Field}" Margin="0,0,0,14"
                                 AutomationProperties.Name="City"
                                 Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Postcode" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PostcodeBox" Style="{StaticResource Field}"
                                 AutomationProperties.Name="Postcode"
                                 Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}"/>

                        <!--
                            A fixed-height slot under the field so both conditions lay out
                            identically. Baseline puts a real TextBlock here — a node in the
                            accessible tree. Faulty leaves it empty and lets
                            DrawnErrorAdorner paint the same sentence into the same space,
                            where it exists only as glyphs.
                        -->
                        <Grid Height="20" Margin="0,5,0,12">
                            <TextBlock x:Name="InlineError"
                                       Text="{Binding PostcodeError}"
                                       FontSize="12"
                                       Foreground="#C02B2B"
                                       AutomationProperties.Name="Postcode error"
                                       Visibility="{Binding HasInlineError, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <Button Content="Save address"
                                AutomationProperties.Name="Save address"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                Height="42" FontSize="14" Margin="0,4,0,12"/>

                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Positive}" FontSize="13"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
