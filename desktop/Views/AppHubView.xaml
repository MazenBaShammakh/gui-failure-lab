<UserControl x:Class="desktop.Views.AppHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Fault-free directory screen for one application (mobile's AppHub, in WPF).
        Carries no defect and never reads the fault mode, so an application whose
        real landing screen is the failure under test still has somewhere safe to
        host its navigation.
    -->
    <Grid Background="{StaticResource Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="680" Margin="40,32,40,48">

                <Button Content="← Applications" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Left" Margin="-8,0,0,16"
                        Command="{Binding GoBackCommand}"/>

                <TextBlock Text="{Binding AppName}" Style="{StaticResource Title}" Margin="0,0,0,24"/>

                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,10" HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Title}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Route}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="8" Padding="18,15">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource InkMuted}"
                                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
