<UserControl x:Class="desktop.Views.SpringboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Canvas}">
        <DockPanel>

            <!-- Shell strip: the only place the fault-mode switch is reachable from -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <TextBlock Text="Workspace" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButton}"
                            Content="⚙  Settings" FontSize="13"
                            AutomationProperties.Name="Settings"
                            Command="{Binding NavigateCommand}" CommandParameter="/settings"/>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" Margin="40,36,40,48">

                    <TextBlock Text="Applications" Style="{StaticResource Title}" Margin="0,0,0,4"/>
                    <TextBlock Text="Open an application to continue." Style="{StaticResource Subtitle}" Margin="0,0,0,28"/>

                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="240" Height="118" Margin="0,0,16,16"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Route}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <Border Width="44" Height="44" CornerRadius="10" HorizontalAlignment="Left"
                                                Background="{Binding Tint}" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Glyph}" FontSize="22"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
