<Window x:Class="desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:desktop.ViewModels"
        xmlns:vmf="clr-namespace:desktop.ViewModels.Failures"
        xmlns:views="clr-namespace:desktop.Views"
        xmlns:vf="clr-namespace:desktop.Views.Failures"
        Title="GUI Failure Lab" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmf:NonClickableCtaViewModel}">
            <vf:NonClickableCtaView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentPage}" />
</Window>
